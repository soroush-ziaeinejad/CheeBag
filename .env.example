# Copy this file to .env and fill in your key. .env is ignored by git; never commit it.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-haiku-5-5
# optional: Room studio's AI room previews (Google Gemini). Without it, Room studio makes demo previews.
GEMINI_API_KEY=
# optional: Room studio's "Online shops" mode (Google Shopping through SerpApi; the free plan is ~250 searches a month)
SERPAPI_KEY=
